# Control plane
# Cloud PostgreSQL (Supabase): a dedicated role and schema, never "public" (Supabase exposes it through its REST API),
# with the server certificate verified against the CA in infra/certs/.
REHEARSAL_DATABASE_URL=postgresql+psycopg://rehearsal:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=infra/certs/supabase-prod-ca-2021.crt
REHEARSAL_DB_POOL_SIZE=2
REHEARSAL_DB_MAX_OVERFLOW=3
# Local alternative: `rehearsal up` starts PostgreSQL in Docker when no cloud URL is set:
#   REHEARSAL_DATABASE_URL=postgresql+psycopg://rehearsal:rehearsal@127.0.0.1:5433/rehearsal
REHEARSAL_DATA_DIR=./var
REHEARSAL_SESSION_SECRET=change-me
# Comma-separated directories the runner may read local application sources from.
REHEARSAL_SOURCE_ROOTS=./examples

# Model fallback chains: provider:model[#think|#nothink][,...], tried in order; a provider without a key is skipped.
# #think / #nothink switches a reasoning model's thinking on or off for that entry (NVIDIA Nemotron reads it).
# Providers: openai, anthropic, google, mistral, xai, deepseek (the vendors' own APIs); groq, together, fireworks,
# cerebras, nebius, nvidia (hosts of open models); openrouter (one key, many models); litellm (LITELLM_BASE_URL),
# modal (MODAL_BASE_URL), local (REHEARSAL_LOCAL_BASE_URL, e.g. vLLM), custom (REHEARSAL_CUSTOM_BASE_URL).
# Unset, every role runs on NVIDIA Nemotron through Nebius Token Factory (NEBIUS_API_KEY):
#   compiler and agents   nebius:nvidia/nemotron-3-super-120b-a12b#think, then Ultra
#   reasoner and improver nebius:nvidia/Nemotron-3-Ultra-550b-a55b#think, then Super
#   simulated customer    nebius:nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B#nothink, then Super
# The reasoner runs the World Compiler's hardest roles (designing, judging and repairing jobs). Another provider, e.g.:
#   REHEARSAL_MODEL_AGENT=openai:gpt-5-mini,anthropic:claude-haiku-4-5,groq:openai/gpt-oss-120b
REHEARSAL_MODEL_COMPILER=
REHEARSAL_MODEL_REASONER=
REHEARSAL_MODEL_AGENT=
REHEARSAL_MODEL_PARTICIPANT=
# Prices are found automatically for nebius, openrouter, litellm, the vendors and groq/together/fireworks/cerebras.
# Others (nvidia, local, custom): USD per 1M tokens [input, output], or a pricing.yaml (see pricing.example.yaml)
REHEARSAL_PRICES={}

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
NEBIUS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Web research for the World Compiler (Tavily): with a key, each build first studies how real people use the
# application (docs, forums, issue trackers) and bases its jobs on that, citing the pages. Without one, it is skipped.
TAVILY_API_KEY=
KAGGLE_API_TOKEN=
# LiteLLM proxy: claude-haiku, claude-sonnet-4.6, claude-opus-4.6, nova-micro, nova-lite, nova-pro, nova-2-lite.
# Prices come from the proxy's /model/info. The aivar key has a $20 budget per 30 days, shared by everyone using it.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1

# Modal endpoint with proxy auth
MODAL_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# "open" lets anyone create an organisation and an admin API key from the console sign-up form; "closed" turns that off
REHEARSAL_SIGNUP=open
# Google sign-in for the console (OAuth web client ID)
GOOGLE_CLIENT_ID=

# Hosted plans and payments. Leave REHEARSAL_PLANS=off on a private server.
REHEARSAL_PLANS=off
# Operator admins, comma-separated; they must sign in with Google
REHEARSAL_ADMIN_EMAILS=
# Free-plan evaluations start only in this window (UTC, HH:MM-HH:MM, may cross midnight)
REHEARSAL_QUIET_HOURS_UTC=18:00-02:00
# Where browsers reach this server (Dodo checkout returns here)
REHEARSAL_PUBLIC_URL=http://localhost:7800
# The documentation site; /docs redirects there. Empty: /docs is the API reference (/api/docs). Locally: http://localhost:3000
REHEARSAL_DOCS_URL=
# Dodo Payments (dashboard: Developer > API keys, Developer > Webhooks). test_mode or live_mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product ids (pdt_...): four subscriptions and two one-time top-ups
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_TEAM_MONTHLY=
DODO_PRODUCT_TEAM_YEARLY=
DODO_PRODUCT_EPISODES_1000=
DODO_PRODUCT_BUILD_1=

