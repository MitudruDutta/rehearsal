# Control plane
REHEARSAL_DATABASE_URL=postgresql+psycopg://rehearsal:rehearsal@127.0.0.1:5433/rehearsal
REHEARSAL_DATA_DIR=./var
REHEARSAL_SESSION_SECRET=change-me
# Comma-separated directories the runner may read local application sources from.
REHEARSAL_SOURCE_ROOTS=./examples

# Model fallback chains: provider:model[,provider:model...]
# Providers: nebius, openrouter, groq, google, openai, anthropic, local (REHEARSAL_LOCAL_BASE_URL), custom (REHEARSAL_CUSTOM_BASE_URL)
REHEARSAL_MODEL_COMPILER=nebius:deepseek-ai/DeepSeek-V4.1-Flash,google:gemini-3.5-flash
REHEARSAL_MODEL_AGENT=nebius:deepseek-ai/DeepSeek-V4.1-Flash,groq:openai/gpt-oss-120b
REHEARSAL_MODEL_PARTICIPANT=nebius:deepseek-ai/DeepSeek-V4.1-Flash,groq:openai/gpt-oss-20b
# USD per 1M tokens [input, output] for providers that do not report cost
REHEARSAL_PRICES={}

NEBIUS_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
TRACING_API_KEY=
KAGGLE_API_TOKEN=

# Modal endpoint with proxy auth
MODAL_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# "open" lets anyone create an organisation and an admin API key from the console sign-up form
REHEARSAL_SIGNUP=closed
