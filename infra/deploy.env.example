# Copy to infra/deploy.env (never commit the filled-in copy) and fill in.
# Keep comments on their own lines: compose reads "KEY=  # text" as the value "# text".

# Public hostname; its DNS A record must point at this machine. Caddy obtains the TLS certificate.
REHEARSAL_DOMAIN=rehearsal.example.com
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
REHEARSAL_SESSION_SECRET=
# "open" lets visitors create their own organisation; "closed" means keys come from `rehearsal bootstrap`.
REHEARSAL_SIGNUP=closed
# Google OAuth web client ID; add https://<REHEARSAL_DOMAIN> as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
NEBIUS_API_KEY=
NEATLOGS_API_KEY=
REHEARSAL_MODEL_COMPILER=nebius:deepseek-ai/DeepSeek-V4.1-Flash
REHEARSAL_MODEL_AGENT=nebius:deepseek-ai/DeepSeek-V4.1-Flash
REHEARSAL_MODEL_PARTICIPANT=nebius:deepseek-ai/DeepSeek-V4.1-Flash

# Limits per workspace on this server (0 = no limit). Each build spends model budget and holds a worker for hours.
REHEARSAL_MAX_ACTIVE_BUILDS=2
REHEARSAL_MAX_ACTIVE_RUNS=2
# Shards per evaluation run. Each shard needs one free worker and one sandbox (0.3-1.5 GB of memory).
REHEARSAL_RUN_PARALLEL=4
# Scenarios a build writes and validates at once. Each validation lane runs its own copy of the application.
REHEARSAL_BUILD_PARALLEL=4
