# Copy to infra/deploy.env (never commit the filled-in copy) and fill in.
# Keep comments on their own lines: compose reads "KEY=  # text" as the value "# text".

# Public hostname; its DNS A record must point at this machine. Caddy obtains the TLS certificate.
REHEARSAL_DOMAIN=rehearsal.example.com
# Control-plane database: a cloud PostgreSQL (Supabase recommended), in the same region as this machine.
# Use a dedicated role and schema, never "public": Supabase exposes the public schema through its REST API.
# The image ships Supabase's public root CA at /srv/rehearsal/infra/certs/, so verify-full checks the server.
REHEARSAL_DATABASE_URL=postgresql+psycopg://rehearsal:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/srv/rehearsal/infra/certs/supabase-prod-ca-2021.crt
# Supabase free allows 60 connections: (API + workers) x (pool size + overflow) must stay well under that.
REHEARSAL_DB_POOL_SIZE=2
REHEARSAL_DB_MAX_OVERFLOW=3
# Only to run PostgreSQL on this machine instead (docker compose ... --profile localdb up -d): set a password with
# `openssl rand -hex 24` and point the URL above at it:
#   REHEARSAL_DATABASE_URL=postgresql+psycopg://rehearsal:<that password>@postgres:5432/rehearsal
POSTGRES_PASSWORD=
# openssl rand -hex 32
REHEARSAL_SESSION_SECRET=
# "open" lets visitors create their own organisation; "closed" means keys come from `rehearsal bootstrap`.
REHEARSAL_SIGNUP=closed
# Google OAuth web client ID; add https://<REHEARSAL_DOMAIN> as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
NEBIUS_API_KEY=
NEATLOGS_API_KEY=
# Optional LiteLLM proxy (Claude, Amazon Nova): use models as litellm:claude-sonnet-4.6
LITELLM_API_KEY=
REHEARSAL_MODEL_COMPILER=nebius:deepseek-ai/DeepSeek-V4.1-Flash
REHEARSAL_MODEL_AGENT=nebius:deepseek-ai/DeepSeek-V4.1-Flash
REHEARSAL_MODEL_PARTICIPANT=nebius:deepseek-ai/DeepSeek-V4.1-Flash

# Limits per workspace on this server (0 = no limit). Each build spends model budget and holds a worker for hours.
REHEARSAL_MAX_ACTIVE_BUILDS=2
REHEARSAL_MAX_ACTIVE_RUNS=2
# Shards per evaluation run. Each shard needs one free worker and one sandbox (0.3-1.5 GB of memory).
REHEARSAL_RUN_PARALLEL=4
# Scenarios a build writes and validates at once. Each validation lane runs its own copy of the application.
REHEARSAL_BUILD_PARALLEL=4

# Plans and payments. "on" enforces the free, Pro and Team plans for every workspace.
REHEARSAL_PLANS=off
# Operator admins, comma-separated. They must sign in with Google; they can set any workspace's plan.
REHEARSAL_ADMIN_EMAILS=
# Free-plan evaluations start only in this window (UTC, may cross midnight).
REHEARSAL_QUIET_HOURS_UTC=18:00-02:00
# Dodo Payments: API key and webhook signing secret (Developer > Webhooks; endpoint https://<REHEARSAL_DOMAIN>/v1/billing/webhook).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode while testing; live_mode with a live API key.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product ids (pdt_...) from the Dodo dashboard.
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_TEAM_MONTHLY=
DODO_PRODUCT_TEAM_YEARLY=
DODO_PRODUCT_EPISODES_1000=
DODO_PRODUCT_BUILD_1=

# Public contact on the landing page ("Talk to us", "Ask for a pilot"): an email address, or a booking/form URL.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_URL=
# Where "Docs" on the landing page leads: the address of the documentation site (docs/). Empty: the API reference at /docs.
NEXT_PUBLIC_DOCS_URL=
