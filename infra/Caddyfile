# HTTPS for the public site (compose.full.yaml, --profile public). Caddy obtains and renews the certificates.
# The bare domain serves Rehearsal; www redirects to it.
{$REHEARSAL_DOMAIN:localhost} {
	encode zstd gzip
	# Browser protections for every response. The CSP only forbids framing, <base> and plugins: the console's
	# scripts and Google sign-in keep working. Deleting Server hides the stack (deletion is applied last).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}
	# "Ask AI" on the docs site (the assistant service), without the /assistant prefix
	handle_path /assistant/* {
		reverse_proxy assistant:4311
	}
	handle {
		reverse_proxy api:7800
	}
}

www.{$REHEARSAL_DOMAIN:localhost} {
	redir https://{$REHEARSAL_DOMAIN:localhost}{uri} permanent
}
