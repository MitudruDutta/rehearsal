# HTTPS for the public site (compose.full.yaml, --profile public). Caddy obtains and renews the certificates.
# The bare domain serves Rehearsal; www redirects to it.
{$REHEARSAL_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy api:7800
}

www.{$REHEARSAL_DOMAIN:localhost} {
	redir https://{$REHEARSAL_DOMAIN:localhost}{uri} permanent
}
