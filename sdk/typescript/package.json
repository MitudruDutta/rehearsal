{
  "name": "rehearsal-kit",
  "version": "0.1.2",
  "description": "TypeScript client for Rehearsal: build practice worlds of real applications, rehearse AI agents in them, fix and prove them.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
